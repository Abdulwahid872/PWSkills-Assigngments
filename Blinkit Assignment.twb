    <worksheet name='Top Performing Products'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Dubai Medium' fontsize='11'>The 🔝 Top N Parameter makes the dashboard dynamic  letting the product team instantly switch between Top 3, Top 5 or all 8 products revealing that Cold Drink leads in Sales but Banana is the true profit champion that deserves maximum business attention.😉</run>
          </formatted-text>
        </caption>
      </layout-options>
