    <worksheet name='City Sales Comparison by Avg. Sales'>
      <layout-options>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>INCLUDE LOD</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'> first calculates average at the </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Product level</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'> then rolls it up to Category or City giving a </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>fairer and more accurate average</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'> than normal AVG which gets distorted by order volume, revealing that </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Snacks ($353) is the true top performing category</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'> and </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Cold Drink ($365) is the highest value product</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'> in your Blinkit dataset.</run>
