      <aliases enabled='yes' />
      <column caption='Delivery Performance per Order' datatype='string' name='[Calculation_1040162858450944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Delivery_Time_Min] &lt;= 30&#13;&#10;THEN &quot;Fast&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='Avg Delivery by City' datatype='real' name='[Calculation_1040162860793857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [City] : AVG([Delivery_Time_Min]) }' />
      </column>
      <column caption='City Delivery Performance' datatype='string' name='[Calculation_1040162861219842]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [City] : AVG([Delivery_Time_Min]) } &lt;= 30&#13;&#10;THEN &quot;Fast&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit Margins %' datatype='real' name='[Calculation_1040162867179523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Profit] / [Sales]) * 100' />
      </column>
      <column caption='Order Profitability' datatype='string' name='[Calculation_1040162867765252]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Profit]/[Sales])*100 &lt; 20&#13;&#10;THEN &quot;Low Profit&quot;&#13;&#10;ELSEIF ([Profit]/[Sales])*100 &lt;= 30&#13;&#10;THEN &quot;Medium Profit&quot;&#13;&#10;ELSE &quot;High Profit&quot;&#13;&#10;END' />
      </column>
      <column caption='Product Rank' datatype='integer' name='[Calculation_1040166720540679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Fixed City Avg Sales' datatype='real' name='[Calculation_1040167755964425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [City] : AVG([Sales]) }' />
      </column>
      <column caption='City vs Benchmark' datatype='string' name='[Calculation_1040167756156938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [City] : AVG([Sales]) } &gt; 339.64&#13;&#10;THEN &quot;Above Benchmark&quot;&#13;&#10;ELSE &quot;Below Benchmark&quot;&#13;&#10;END' />
      </column>
      <column caption='Avg Sales per Product (INCLUDE)' datatype='real' name='[Calculation_1040167761068043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Product_Name] : AVG([Sales]) }' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Delivery Time Min' datatype='integer' name='[Delivery_Time_Min]' role='measure' type='quantitative' />
