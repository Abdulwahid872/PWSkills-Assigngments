            <run bold='true' fontcolor='#000000' fontsize='11' italic='false' underline='false'>Insight&#9;         </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11' italic='false' underline='false'>Æ             </run>
            <run bold='true' fontcolor='#000000' fontsize='11' italic='false' underline='false'>Detail&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10' italic='false' underline='false'>Fast deliveries&#9;</run>
            <run bold='false' fontcolor='#000000' fontsize='10' italic='false' underline='false'>433 orders — 43.3%&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10' italic='false' underline='false'>Delayed deliveries&#9;</run>
            <run bold='false' fontcolor='#000000' fontsize='10' italic='false' underline='false'>567 orders — 56.7%&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10' italic='false' underline='false'>Average delivery time&#9;</run>
            <run bold='false' fontcolor='#000000' fontsize='10' italic='false' underline='false'>34.4 min — above the 30 min threshold
</run>
            <run bold='true' fontcolor='#000000' fontsize='10' italic='false' underline='false'>Fastest delivery&#9;</run>
            <run bold='false' fontcolor='#000000' fontsize='10' italic='false' underline='false'>10 minutes&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10' italic='false' underline='false'>Slowest delivery&#9;</run>
            <run bold='false' fontcolor='#000000' fontsize='10' italic='false' underline='false'>59 minutes&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10' italic='false' underline='false'>Overall status&#9;</run>
            <run bold='false' fontcolor='#000000' fontsize='10' italic='false' underline='false'>⚠️ Majority orders are delayed&#10;</run>
